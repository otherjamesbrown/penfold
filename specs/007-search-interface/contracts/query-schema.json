{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penfold.local/schemas/search-query.json",
  "title": "Search Query Schema",
  "description": "JSON Schema for Penfold search query validation",
  "type": "object",
  "required": ["query_text"],
  "properties": {
    "query_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Natural language search query text"
    },
    "content_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["email", "meeting", "document", "slack", "all"]
      },
      "default": ["all"],
      "description": "Content types to include in search"
    },
    "temporal": {
      "$ref": "#/$defs/TemporalConstraint"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "maxItems": 20,
      "description": "Filter by participant email addresses"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 10,
      "description": "Filter by project names"
    },
    "min_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Minimum AI confidence score for results"
    },
    "include_relationships": {
      "type": "boolean",
      "default": true,
      "description": "Include related content discovery in results"
    },
    "sort_by": {
      "type": "string",
      "enum": ["relevance", "recency", "alphabetical"],
      "default": "relevance",
      "description": "Sort order for results"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25,
      "description": "Maximum number of results to return"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Offset for pagination"
    }
  },
  "$defs": {
    "TemporalConstraint": {
      "type": "object",
      "description": "Temporal filtering constraints",
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date-time",
          "description": "Start of date range filter"
        },
        "end_date": {
          "type": "string",
          "format": "date-time",
          "description": "End of date range filter"
        },
        "relative_expression": {
          "type": "string",
          "maxLength": 100,
          "description": "Natural language temporal expression",
          "examples": [
            "last week",
            "since December",
            "before the new year",
            "around the deployment",
            "3 days ago"
          ]
        }
      },
      "anyOf": [
        {"required": ["start_date"]},
        {"required": ["end_date"]},
        {"required": ["relative_expression"]}
      ]
    },
    "SearchFilter": {
      "type": "object",
      "description": "Search filter configuration",
      "properties": {
        "filter_type": {
          "type": "string",
          "enum": ["content_type", "participant", "project", "date_range", "confidence"]
        },
        "criteria": {
          "type": "object",
          "description": "Filter-specific criteria"
        },
        "is_active": {
          "type": "boolean",
          "default": true
        }
      },
      "required": ["filter_type", "criteria"]
    }
  },
  "examples": [
    {
      "query_text": "customer deployment issues",
      "content_types": ["email", "meeting"],
      "limit": 25
    },
    {
      "query_text": "Atlas project decisions",
      "temporal": {
        "relative_expression": "since December"
      },
      "include_relationships": true
    },
    {
      "query_text": "budget discussions",
      "participants": ["john@company.com", "jane@company.com"],
      "projects": ["Q1 Planning"],
      "min_confidence": 0.7,
      "sort_by": "recency"
    }
  ]
}
