# Meeting Pipeline Configuration Example
# Copy to .env and customize for your environment

# Application settings
HOST=localhost
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database settings
DATABASE_URL=postgresql://localhost/penfold_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# File storage settings
UPLOAD_DIR=/Users/your-username/penfold-uploads
PROCESSED_DIR=/Users/your-username/penfold-processed
MAX_UPLOAD_SIZE=2147483648
CHUNK_SIZE=10485760

# Speech-to-Text settings
WHISPER_MODEL_SIZE=large-v3
STT_CONFIDENCE_THRESHOLD=0.8
USE_LOCAL_STT_ONLY=false
# GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/credentials.json

# Privacy and security
ENCRYPTION_KEY_PATH=/Users/your-username/.penfold/encryption-keys
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Processing settings
MAX_CONCURRENT_JOBS=20
MAX_CPU_INTENSIVE_JOBS=4
JOB_TIMEOUT_SECONDS=7200
FIFO_QUEUE_ENABLED=true

# Optional Redis for external events
# REDIS_URL=redis://localhost:6379/0

# OpenAI for embeddings (when available)
# OPENAI_API_KEY=your-openai-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Performance tuning
PROCESSING_BATCH_SIZE=10
SEARCH_RESULTS_LIMIT=50
VECTOR_SEARCH_LIMIT=100