# Penfold MCP Server Environment Configuration
# Deploy to /etc/penfold/mcp.env on dev02

# Tenant ID (same as other Penfold services)
PENFOLD_TENANT_ID=c3170310-78bd-409c-b186-126f40bfa6ad

# Upstream gateway (local on dev02)
PENFOLD_GATEWAY_ADDR=localhost:50051

# MCP server listen address (50056 — 50055 is AI coordinator)
MCP_LISTEN_ADDR=:50056

# Gateway TLS (matches gateway config)
PENFOLD_GATEWAY_TLS_CA=/home/james/.penfold/certs/ca.crt

# Logging
PENFOLD_LOG_LEVEL=info
