[Unit]
Description=Penfold Gmail Connector Service
Documentation=https://github.com/otherjamesbrown/penfold
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=james
Group=james
EnvironmentFile=/etc/penfold/gmail.env
Environment=GMAIL_GRPC_PORT=50053
Environment=GMAIL_HTTP_PORT=8083
ExecStartPre=/usr/bin/test -x /opt/penfold/bin/penfold-gmail
ExecStart=/opt/penfold/bin/penfold-gmail
Restart=always
TimeoutStopSec=30
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=penfold-gmail

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/penfold /var/log/penfold
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Allow reading OAuth credentials
ReadOnlyPaths=/opt/penfold/config

[Install]
WantedBy=multi-user.target
